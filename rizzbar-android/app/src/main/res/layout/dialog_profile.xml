<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/pName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name / nickname"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/pStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Relationship stage (new match, dating, girlfriend…)"
            android:inputType="text" />

        <EditText
            android:id="@+id/pStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Her texting style (short, dry, emoji-heavy…)"
            android:inputType="text" />

        <EditText
            android:id="@+id/pNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Inside jokes / running bits / what she's into"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <EditText
            android:id="@+id/pAvoid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Topics to avoid"
            android:inputType="text" />

        <TextView
            android:id="@+id/pSpiceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Spice ceiling: 2/5" />

        <SeekBar
            android:id="@+id/pSpice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="4" />

    </LinearLayout>
</ScrollView>
